# Template, not a static config: the stock nginx:1.27-alpine image's
# built-in entrypoint runs `envsubst` on every *.template file under
# /etc/nginx/templates/ at CONTAINER START (not build time) and writes the
# result to /etc/nginx/conf.d/ before nginx boots. That's what makes
# ${BACKEND_URL} and ${PORT} below resolve from real environment variables
# set on the running container — required because the backend's Render URL
# isn't known until after the backend service is deployed, so it can't be
# baked in at image-build time.
#
# BACKEND_URL contract: set it WITHOUT a trailing slash (e.g.
# "https://fcg-backend.onrender.com", not ".../"). The rewrite+proxy_pass
# pairing below strips the /api/ prefix before forwarding regardless of
# that, but mixing a trailing-slash proxy_pass target with `rewrite ...
# break` is a well-known nginx footgun (can produce a doubled slash) — the
# no-trailing-slash contract avoids it entirely rather than relying on
# nginx's more fragile trailing-slash prefix-replacement behavior.
#
# PORT: same reasoning as the backend's Dockerfile — Render assigns this
# dynamically and expects the container to bind to it. Defaults to 80 for
# docker-compose/local use, where nothing sets $PORT.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React Router client-side routing: any path that isn't a real static
    # file falls back to index.html so e.g. /accounts/8000E1590 works on a
    # hard refresh, not just via in-app navigation.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
