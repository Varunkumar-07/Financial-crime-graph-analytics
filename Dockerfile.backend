# syntax=docker/dockerfile:1
#
# Backend (FastAPI) image. Multi-stage: the builder stage installs Python
# packages (including compiling anything without prebuilt wheels) into an
# isolated prefix; the runtime stage copies only that prefix plus the app
# code and the seeded demo dataset, discarding pip's cache and any build
# toolchain — meaningfully smaller than a single-stage build.
#
# Bundles a seeded demo dataset (data/processed/, ~384MB) directly into the
# image rather than mounting a volume or downloading at startup — see
# notebooks/docker_summary.md for the full rationale. Only the 5 files
# api/models/state.py actually loads at runtime are copied; data/raw/ (raw
# CSVs) and the unused classical-baseline model files are not.

FROM python:3.12-slim AS builder
WORKDIR /build

# CPU-only torch wheel: the default PyPI Linux wheel bundles CUDA runtime
# libraries this project never uses (GraphSAGE runs on CPU — see
# notebooks/gnn_baseline_summary.md) and would otherwise dominate image size.
RUN pip install --no-cache-dir --prefix=/install torch==2.13.0 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements-api.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-api.txt


FROM python:3.12-slim
WORKDIR /app

COPY --from=builder /install /usr/local

COPY src/ ./src/

# Seeded demo dataset — see module docstring above.
COPY data/processed/transaction_graph.gpickle ./data/processed/transaction_graph.gpickle
COPY data/processed/pyg_data.pt ./data/processed/pyg_data.pt
COPY data/processed/account_features.csv ./data/processed/account_features.csv
COPY data/processed/graphsage_baseline.pt ./data/processed/graphsage_baseline.pt
COPY data/processed/all_cycles_cache.pkl ./data/processed/all_cycles_cache.pkl

# Configurable, not hardcoded — see api/main.py. docker-compose.yml overrides
# this for the containerized frontend's actual origin; Render's dashboard
# overrides it again post-deploy once the frontend's Render URL is known.
ENV CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render assigns the actual port dynamically via $PORT (commonly 10000, but
# never assume a fixed value) and routes traffic to whatever the container
# binds to — a hardcoded port would silently break on Render. Default 8000
# below is only for docker-compose/local runs, where nothing sets $PORT.
# Shell form (not exec-form CMD) is required for $PORT to expand at all.
ENV PORT=8000
EXPOSE 8000
WORKDIR /app/src
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT}
